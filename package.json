{
  "name": "handcash-mobile",
  "version": "0.1.747",
  "private": true,
  "description": "HandCash Mobile — Capacitor shell over @handcash/wallet-ui (Desktop src).",
  "type": "module",
  "license": "Open BSV License",
  "dependencies": {
    "@bsv/sdk": "^2.8.1",
    "@bsv/verifast": "^0.3.6",
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "@handcash/wallet-engine": "file:../HANDCASH-DESKTOP/packages/wallet-engine",
    "@handcash/wallet-ui": "file:../HANDCASH-DESKTOP/packages/wallet-ui",
    "@xstate/react": "^5.0.3",
    "@zxing/browser": "^0.1.5",
    "aeon-ui-engine": "^1.3.5",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "mermaid": "^11.16.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xstate": "^5.19.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ../HANDCASH-DESKTOP/scripts/build-wallet-engine.mjs && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "bash scripts/build-apk.sh",
    "cap:sync:ios": "npm run build && npx cap sync ios && node scripts/patch-ios.mjs",
    "ios": "bash scripts/build-ios.sh",
    "ios:testflight": "HANDCASH_IOS_UPLOAD=1 bash scripts/build-ios.sh",
    "test:ios-native": "bash scripts/test-ios-native.sh",
    "assert:ui-core": "node scripts/assert-ui-core.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "plist": "^3.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
