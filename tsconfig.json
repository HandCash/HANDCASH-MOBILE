{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "../HANDCASH-DESKTOP/src/*"
      ],
      "@desktop/*": [
        "../HANDCASH-DESKTOP/src/*"
      ],
      "@handcash/wallet-ui": [
        "../HANDCASH-DESKTOP/src/App.tsx"
      ],
      "@handcash/wallet-ui/*": [
        "../HANDCASH-DESKTOP/src/*"
      ],
      "@aeon-ui/core": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/core/src/index.ts"
      ],
      "@aeon-ui/primitives": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/primitives/src/index.ts"
      ],
      "@aeon-ui/react": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/react/src/index.ts"
      ],
      "@aeon-ui/ui": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/ui/src/index.ts"
      ],
      "@aeon-ui/surface": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/surface/src/index.ts"
      ],
      "@aeon-ui/panda/styled-system/css": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/panda/styled-system/css/index.d.ts"
      ],
      "@aeon-ui/panda/styled-system/recipes": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/panda/styled-system/recipes/index.d.ts"
      ],
      "@aeon-ui/tree": [
        "../HANDCASH-DESKTOP/vendor/aeon-ui-engine/packages/tree/src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src",
    "../HANDCASH-DESKTOP/src"
  ],
  "exclude": [
    "../HANDCASH-DESKTOP/src/**/*.test.ts",
    "../HANDCASH-DESKTOP/src/**/*.test.tsx",
    "src/**/*.test.ts"
  ]
}
